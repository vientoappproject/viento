<?xml version='1.0' encoding='utf-8'?>
<widget id="com.vientoappproject.app" version="1.0.0" xmlns="http://w3.org" xmlns:cdv="http://apache.org">
    <name>VienTo</name>
    <description>La Red Social Sana de Abya Yala</description>
    <author email="admin@vientoappproject.github.io">Comuna Digital</author>
    
    <!-- Dice al sistema di far partire l'interfaccia a schede -->
    <content src="index.html" />
    
    <!-- Sblocca i permessi hardware per galleria e telecamera del telefono -->
    <plugin name="cordova-plugin-camera" spec="8.0.0" />
    <plugin name="cordova-plugin-media" spec="~5.0.3" />
    <plugin name="cordova-plugin-file" spec="~6.0.2" />

    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <preference name="ScrollEnabled" value="false" />
    <preference name="Orientation" value="portrait" />
</widget>
